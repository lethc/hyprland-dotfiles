#!/bin/bash
# Restart a status bar without logging out.
# Usage: restartBar {quickshell|waybar}

restart_quickshell() {
    if pgrep -x "quickshell" > /dev/null; then
        pkill -x "quickshell"
        # Wait for the old instance to fully exit so the new one can own
        # the notification/tray buses instead of racing it.
        for _ in $(seq 1 20); do
            pgrep -x "quickshell" > /dev/null || break
            sleep 0.1
        done
    fi
    ~/.config/hypr/dots/.scripts/Hyprland/toggleFocusMode focus && quickshell -d
}

restart_waybar() {
    if pgrep -x "waybar" > /dev/null; then
        ~/.config/hypr/dots/.scripts/Hyprland/toggleFocusMode focus && killall waybar && waybar &
        # ~/.config/hypr/dots/.scripts/Hyprland/toggleFocusMode focus && pkill -USR2 waybar & # -USR2 is a custom signal that will trigger waybar to reload its config
        # -USR1 will hide the bar
    else
        ~/.config/hypr/dots/.scripts/Hyprland/toggleFocusMode focus && waybar &
    fi
}

case "$1" in
    quickshell)
        restart_quickshell
        ;;
    waybar)
        restart_waybar
        ;;
    *)
        echo "Usage: $0 {quickshell | waybar}"
        exit 1
        ;;
esac
