* {
    /* Kanagawa Dragon Theme - Based on the Dragon palette */
    
    /* Backgrounds - Deep layers from Dragon Black */
    bg0:    #12120fE6;        /* dragonBlack1 with slight opacity */
    bg1:    #1D1C1980;        /* dragonBlack2 with transparency */
    bg2:    #C4B28AE6;        /* dragonBlue2 accent with opacity */
    
    /* Foregrounds - Dragon neutrals */
    fg0:    #c5c9c5;          /* dragonWhite (primary text) */
    fg1:    #12120f;          /* dragonGray (secondary text) */
    fg2:    #c5c9c580;        /* dragonWhite with transparency */
    
    transparent: rgba(18, 18, 15, 0.1);  /* Transparent dragonBlack1 layer */
}
